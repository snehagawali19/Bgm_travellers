# Copy this file to `.env` in the same folder and to `backend/.env`.
# Never commit real secrets. All values below are placeholders.

# --- Database ---
DATABASE_URL=postgresql+psycopg://bgm:bgm_dev_password@127.0.0.1:5432/bgm_travels
TEST_DATABASE_URL=postgresql+psycopg://bgm:bgm_dev_password@127.0.0.1:5433/bgm_travels_test

# --- API ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
HOLD_TTL_MINUTES=10
BUS_TURNAROUND_MINUTES=180
CANCELLATION_CUTOFF_MINUTES=60
OFFLINE_PAYMENT_METHODS=["cash","upi","bank_transfer"]

# --- WhatsApp Business Cloud API ---
# Keep credentials in .env only. The API queues messages; app.worker sends them.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
# Approved utility template with exactly one body text parameter (the update).
WHATSAPP_TEMPLATE_NAME=bgm_booking_update
WHATSAPP_TEMPLATE_LANGUAGE=en
NOTIFICATION_MAX_ATTEMPTS=5

# --- Admin bootstrap (change immediately) ---
ADMIN_EMAIL=admin@bgmtravels.in
ADMIN_PASSWORD=Admin123
ADMIN_NAME=BGM Operator

# --- Payments ---
# razorpay = live Razorpay Test/Live SDK
# fake = labeled test double for automated tests and local demo without keys
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
PAYMENTS_LIVE_ENABLED=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
NEXT_PUBLIC_BRAND_NAME=BGM Travels
